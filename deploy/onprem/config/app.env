# Non-secret app settings for the on-prem box. Committed in plain text.
# Push a change to main and the box applies it within ~5 minutes.
#
# Keys are Spring properties in env-var form: auth0.clientId -> AUTH0_CLIENTID,
# printnode.printer.id -> PRINTNODE_PRINTER_ID, etc. Anything here overrides
# application.yml. Secrets go in secrets.env (encrypted), never here.

# --- Required (app won't start without these) ---
# Auth0 Management API (M2M) application client id, same as the AWS prod task.
#AUTH0_CLIENTID=
#PRINTNODE_PRINTER_ID=
