# Template for secrets.env. DO NOT put real values in this file.
#
#   cp secrets.example.env secrets.env      # fill in values
#   sops encrypt -i secrets.env             # encrypts in place using .sops.yaml
#   git add secrets.env && git commit && git push
#
# Later edits:  sops secrets.env  (decrypts into $EDITOR, re-encrypts on save)

# --- Required by the app ---
AUTH0_CLIENTSECRET=
PRINTNODE_API_KEY=
GROUPME_BOTID=

# --- Optional integrations ---
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_BUGS=
POSTHOG_API_KEY=
# Better Stack log shipping (prod profile). Strongly recommended: it is how you
# see the box's logs without logging into it.
LOGTAIL_TOKEN=

# --- Box operations ---
# Slack incoming webhook; the box posts deploy successes/failures/rollbacks here.
DEPLOY_WEBHOOK_URL=
# Only when INGRESS=cloudflared on the box.
TUNNEL_TOKEN=
